<?xml version="1.0"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi"
     xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
   <Product Id="*"
            Name="WindowTabs"
            Language="1033"
            Version="26.09.02.1"
            Manufacturer="Satoshi Yamamoto (standard-software)"
            UpgradeCode="6763D234-BCFA-4172-8190-756DEE9CF2B1">

      <Package Compressed="yes"
               InstallerVersion="200"
               Platform="x64"
               Description="WindowTabs Installer"
               Comments="Brings browser-style tabbed window management to the desktop" />

      <Media Id="1" Cabinet="product.cab" EmbedCab="yes"/>

      <!-- Upgrade settings: Remove all previous versions -->
      <!-- AllowSameVersionUpgrades="yes" allows reinstall of same version -->
      <MajorUpgrade DowngradeErrorMessage="A newer version of WindowTabs is already installed."
                    Schedule="afterInstallInitialize"
                    AllowSameVersionUpgrades="yes"
                    RemoveFeatures="ALL" />

      <!-- Installation directory structure -->
      <Directory Id="TARGETDIR" Name="SourceDir">
         <Directory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="WindowTabs">
               <Component Id="MainExecutable" Guid="3C67513D-01DD-4637-8A68-80971EB9504F" Win64="yes">
                  <!-- Main executable (all DLLs are merged using ILRepack) -->
                  <File Id="WindowTabsExe"
                        Source="$(var.WtProgram.TargetDir)WindowTabs.exe"
                        KeyPath="yes" />

                  <!-- Configuration file -->
                  <File Id="WindowTabsConfig"
                        Source="$(var.WtProgram.TargetDir)WindowTabs.exe.config" />

                  <!-- Version history file -->
                  <File Id="VersionMd"
                        Source="$(var.WtProgram.ProjectDir)..\version.md" />

                  <!-- README file -->
                  <File Id="ReadmeTxt"
                        Source="$(var.WtProgram.ProjectDir)..\WtSetup\README.txt" />
               </Component>

               <!-- Language folder -->
               <Directory Id="LanguageFolder" Name="Language">
                  <Component Id="LanguageFiles" Guid="D8E5F4A6-7F9C-0123-DEFA-AB4567890123" Win64="yes">
                     <!-- Clear the folder before the new defaults are laid down.
                          MSI leaves a file it did not write untouched, so a
                          user-edited language file would otherwise survive an
                          upgrade and hide the new strings. The copy made by
                          the installer-backup-modified step is what preserves
                          the edits. RemoveFiles runs before InstallFiles, and
                          only when this component is being installed. -->
                     <RemoveFile Id="RemoveStaleLanguageJson" Name="*.json" On="install" />

                     <File Id="FileListJson"
                           Source="$(var.WtProgram.TargetDir)Language\FileList.json"
                           KeyPath="yes" />
                     <File Id="EnglishJson"
                           Source="$(var.WtProgram.TargetDir)Language\English.json" />
                     <File Id="JapaneseJson"
                           Source="$(var.WtProgram.TargetDir)Language\Japanese.json" />
                     <File Id="JapaneseKansaiJson"
                           Source="$(var.WtProgram.TargetDir)Language\Japanese_Kansai.json" />
                     <File Id="JapaneseTohokuJson"
                           Source="$(var.WtProgram.TargetDir)Language\Japanese_Tohoku.json" />
                     <File Id="ChineseSimplifiedJson"
                           Source="$(var.WtProgram.TargetDir)Language\Chinese_Simplified.json" />
                     <File Id="ChineseTraditionalJson"
                           Source="$(var.WtProgram.TargetDir)Language\Chinese_Traditional.json" />
                     <File Id="KoreanJson"
                           Source="$(var.WtProgram.TargetDir)Language\Korean.json" />
                     <File Id="FrenchJson"
                           Source="$(var.WtProgram.TargetDir)Language\French.json" />
                     <File Id="GermanJson"
                           Source="$(var.WtProgram.TargetDir)Language\German.json" />
                     <File Id="ItalianJson"
                           Source="$(var.WtProgram.TargetDir)Language\Italian.json" />
                     <File Id="SpanishJson"
                           Source="$(var.WtProgram.TargetDir)Language\Spanish.json" />
                     <File Id="PortugueseJson"
                           Source="$(var.WtProgram.TargetDir)Language\Portuguese.json" />
                     <File Id="TurkishJson"
                           Source="$(var.WtProgram.TargetDir)Language\Turkish.json" />
                     <File Id="PolishJson"
                           Source="$(var.WtProgram.TargetDir)Language\Polish.json" />
                     <File Id="VietnameseJson"
                           Source="$(var.WtProgram.TargetDir)Language\Vietnamese.json" />
                     <File Id="IndonesianJson"
                           Source="$(var.WtProgram.TargetDir)Language\Indonesian.json" />
                  </Component>
               </Directory>

               <!-- Settings folder -->
               <Directory Id="SettingsFolder" Name="Settings">
                  <Component Id="SettingsFiles" Guid="E9F1A2B3-4C5D-6E7F-8A9B-0C1D2E3F4A5B" Win64="yes">
                     <RemoveFile Id="RemoveStaleSettingsJson" Name="*.json" On="install" />

                     <File Id="WindowMarginJson"
                           Source="$(var.WtProgram.TargetDir)Settings\Window_Margin.json"
                           KeyPath="yes" />

                     <File Id="VersionFolderJson"
                           Source="$(var.WtProgram.TargetDir)Settings\Version_Folder.json" />
                  </Component>
               </Directory>

               <!-- Registry entries for installation path persistence -->
               <Component Id="RegistryEntries" Guid="A5B2E1C3-4D6F-7890-ABCD-EF1234567890" Win64="yes" Permanent="yes">
                  <RegistryKey Root="HKCU"
                               Key="Software\WindowTabs">
                     <RegistryValue Type="string"
                                    Name="InstallPath"
                                    Value="[INSTALLFOLDER]"
                                    KeyPath="yes"/>
                  </RegistryKey>
               </Component>
            </Directory>
         </Directory>

         <!-- Start Menu -->
         <Directory Id="ProgramMenuFolder">
            <Directory Id="ApplicationProgramsFolder" Name="WindowTabs">
               <Component Id="ApplicationShortcut" Guid="B6C3F2E4-5D7A-8901-BCDE-EF2345678901" Win64="yes">
                  <Shortcut Id="ApplicationStartMenuShortcut"
                           Name="WindowTabs"
                           Description="Browser-style tabbed window management"
                           Target="[INSTALLFOLDER]WindowTabs.exe"
                           WorkingDirectory="INSTALLFOLDER"
                           Icon="BemoIcon.ico" />

                  <RemoveFolder Id="CleanUpShortCut"
                                Directory="ApplicationProgramsFolder"
                                On="uninstall"/>

                  <RegistryValue Root="HKCU"
                                 Key="Software\WindowTabs"
                                 Name="StartMenuShortcut"
                                 Type="integer"
                                 Value="1"
                                 KeyPath="yes"/>
               </Component>
            </Directory>
         </Directory>

         <!-- Desktop Shortcut (optional) -->
         <Directory Id="DesktopFolder" Name="Desktop">
            <Component Id="DesktopShortcut" Guid="C7D4E3F5-6E8B-9012-CDEF-EA3456789012" Win64="yes">
               <Shortcut Id="DesktopShortcutIcon"
                        Name="WindowTabs"
                        Description="Browser-style tabbed window management"
                        Target="[INSTALLFOLDER]WindowTabs.exe"
                        WorkingDirectory="INSTALLFOLDER"
                        Icon="BemoIcon.ico" />

               <RegistryValue Root="HKCU"
                              Key="Software\WindowTabs"
                              Name="DesktopShortcut"
                              Type="integer"
                              Value="1"
                              KeyPath="yes"/>
            </Component>
         </Directory>
      </Directory>

      <!-- Icon definition -->
      <Icon Id="BemoIcon.ico" SourceFile="..\WtProgram\Resources\Bemo.ico"/>
      <Property Id="ARPPRODUCTICON" Value="BemoIcon.ico" />

      <!-- Remember installation directory for upgrades -->
      <Property Id="INSTALLFOLDER">
         <RegistrySearch Id="RememberInstallFolder"
                        Root="HKCU"
                        Key="Software\WindowTabs"
                        Name="InstallPath"
                        Type="raw"
                        Win64="yes" />
      </Property>

      <!-- Launch application after installation -->
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch WindowTabs" />
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

      <CustomAction Id="LaunchApplication"
                    FileKey="WindowTabsExe"
                    ExeCommand=""
                    Execute="immediate"
                    Impersonate="yes"
                    Return="asyncNoWait" />

      <!-- Close running WindowTabs before installation -->
      <util:CloseApplication Id="CloseWindowTabs"
                              Target="WindowTabs.exe"
                              CloseMessage="yes"
                              Description="WindowTabs is currently running. Click OK to close it and continue installation, or Cancel to exit."
                              RebootPrompt="no"
                              TerminateProcess="0"
                              Timeout="5" />

      <!-- Backup user-modified Language/Settings files, and record file hashes.
           These two steps run inside WindowTabs.exe: the MSI used to carry them
           as "powershell.exe -NoProfile -EncodedCommand <base64>" custom
           actions, and Defender's machine-learning classifier reported the
           installer as Trojan:Script/Wacatac.H!ml on that basis. Base64 script
           that reads the registry, hashes a directory tree, copies and deletes
           files is what a dropper looks like, whatever it actually does. The
           MSI now carries no script at all.

           BackupModifiedFiles runs from the OUTGOING install, before anything
           is touched, so its path comes from the registry rather than from a
           file this package installs. On a first install there is no previous
           path and the action is skipped. -->
      <Property Id="PREVIOUSINSTALLFOLDER">
         <RegistrySearch Id="FindPreviousInstallFolder"
                         Root="HKCU"
                         Key="Software\WindowTabs"
                         Name="InstallPath"
                         Type="raw"
                         Win64="yes" />
      </Property>

      <SetProperty Id="PREVIOUSINSTALLEXE"
                   Value="[PREVIOUSINSTALLFOLDER]WindowTabs.exe"
                   Before="BackupModifiedFiles"
                   Sequence="execute">PREVIOUSINSTALLFOLDER</SetProperty>

      <CustomAction Id="BackupModifiedFiles"
                    Property="PREVIOUSINSTALLEXE"
                    ExeCommand="--installer-backup-modified"
                    Execute="immediate"
                    Impersonate="yes"
                    Return="ignore" />

      <CustomAction Id="StoreFileHashes"
                    FileKey="WindowTabsExe"
                    ExeCommand="--installer-store-hashes"
                    Execute="immediate"
                    Impersonate="yes"
                    Return="ignore" />

      <InstallExecuteSequence>
         <Custom Action="BackupModifiedFiles" Before="InstallInitialize">
            PREVIOUSINSTALLEXE
         </Custom>
         <Custom Action="StoreFileHashes" After="InstallFinalize">
            REINSTALL OR NOT REMOVE
         </Custom>
      </InstallExecuteSequence>

      <!-- Features -->
      <Feature Id="MainApplication"
               Title="WindowTabs"
               Description="Main application files"
               Level="1"
               ConfigurableDirectory="INSTALLFOLDER">
         <ComponentRef Id="MainExecutable"/>
         <ComponentRef Id="LanguageFiles"/>
         <ComponentRef Id="SettingsFiles"/>
         <ComponentRef Id="RegistryEntries"/>
         <ComponentRef Id="ApplicationShortcut"/>
      </Feature>

      <Feature Id="DesktopShortcutFeature"
               Title="Desktop Shortcut"
               Description="Create a desktop shortcut"
               Level="1">
         <ComponentRef Id="DesktopShortcut"/>
      </Feature>

      <!-- Basic UI with installation directory selection -->
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

      <UI>
         <UIRef Id="WixUI_InstallDir" />

         <!-- Skip License Agreement Dialog -->
         <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2">1</Publish>
         <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2">1</Publish>

         <!-- Launch application on finish -->
         <Publish Dialog="ExitDialog"
                  Control="Finish"
                  Event="DoAction"
                  Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
      </UI>

   </Product>
</Wix>
