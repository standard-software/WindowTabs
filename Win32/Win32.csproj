<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>Bemo.Win32</RootNamespace>
    <AssemblyName>Win32</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO1000: a WinForms analyzer added in .NET 8 that wants every public
         property on a Control to say how the *designer* should serialize it.
         Every control in here is built in code and never dropped on a design
         surface, so there is nothing to serialize and the four properties it
         names (HotKey, Hotkey, HotkeyModifiers, ClickThrough) are correct as
         they stand. Suppressed rather than answered with attributes so no
         design-time metadata is invented for a designer that never runs. -->
    <NoWarn>0649;WFO1000</NoWarn>
    <!-- The app is Windows-only by construction (P/Invoke throughout, and the
         manifest declares Per-Monitor-V2). Naming the floor here is what stops
         CA1416 from flagging every Windows API call as possibly unreachable;
         7.0 = Windows 10, the oldest this targets. -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <!-- The P/Invoke declarations below are hand-written for a specific
         architecture-neutral layout; nothing here is platform specific. -->
    <Platforms>AnyCPU</Platforms>
    <!-- Assembly identity is kept in Properties\AssemblyInfo.cs rather than
         generated, so the shipped file version (1.0.651.0) survives. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Left over from an unrelated project ("QuickLicense") and never part of
         the build: the legacy csproj listed every file explicitly and this one
         was not among them. SDK-style projects compile *.cs implicitly, so it
         has to be excluded by hand or its assembly attributes collide with
         Properties\AssemblyInfo.cs. -->
    <Compile Remove="AssemblyInfo.cs" />
  </ItemGroup>

</Project>
