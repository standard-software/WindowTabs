<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <RootNamespace>Aga.Controls</RootNamespace>
    <AssemblyName>Aga.Controls</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SignAssembly>false</SignAssembly>
    <!-- Identity stays in Properties\AssemblyInfo.cs, as it was. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Windows-only by construction; see Win32.csproj for the same note. -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <!-- WFO1000 is the .NET 8+ WinForms designer-serialization analyzer. This
         is a third-party control library written long before it existed and
         WindowTabs builds every tree in code, so there is no designer to
         serialize for. -->
    <NoWarn>WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Design-time only, and System.Design does not exist on .NET 10.
         StringCollectionEditor derives from CollectionEditor purely to give
         the Visual Studio designer a nicer editor for NodeComboBox's
         DropDownItems; nothing reads it at run time. The matching [Editor]
         attributes, and NodeControlsCollection's NodeControlCollectionEditor,
         have been removed for the same reason. -->
    <Compile Remove="StringCollectionEditor.cs" />
    <!-- Not part of the library: the legacy project listed its files
         explicitly and these were not among them. -->
    <Compile Remove="bin\**" />
    <Compile Remove="obj\**" />
  </ItemGroup>

</Project>
