<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>WinExe</OutputType>
    <RootNamespace>WindowTabs</RootNamespace>
    <AssemblyName>WindowTabs</AssemblyName>
    <ApplicationIcon>Resources\Bemo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>0040;0046;0058;0064;0760;1182;1183;2009;FS0064;WFO1000</NoWarn>
    <!-- The DPI awareness in app.manifest is what keeps the layered tab strips
         on their monitor's real pixel grid; see the manifest for why there is
         deliberately no <compatibility> block in it. -->
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <Tailcalls>false</Tailcalls>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <Tailcalls>true</Tailcalls>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- F# compiles in order: this list is the build, not a view of a folder. -->
  <ItemGroup>
    <Compile Include="Localization\Localization_English.fs" />
    <Compile Include="Localization\JsoncHelper.fs" />
    <!-- Shared source kept early in the order; the legacy project linked it
         under Localization to work around a project-system load failure. -->
    <Compile Include="Shared\UserOverrides.fs" />
    <Compile Include="Localization\Localization.fs" />
    <Compile Include="Shared\Operators.fs" />
    <Compile Include="Shared\Dynamic.fs" />
    <Compile Include="Shared\Observable.fs" />
    <Compile Include="Shared\Blackboard.fs" />
    <Compile Include="Shared\Invoker.fs" />
    <Compile Include="Shared\DialogState.fs" />
    <Compile Include="Shared\Cell.fs" />
    <Compile Include="Shared\Drawing.fs" />
    <Compile Include="Shared\Sprite.fs" />
    <Compile Include="Shared\TabStripTypes.fs" />
    <Compile Include="Shared\TabOrder.fs" />
    <Compile Include="Shared\SavedTabState.fs" />
    <Compile Include="Shared\SavedSession.fs" />
    <Compile Include="Shared\Regroup.fs" />
    <Compile Include="Shared\AppPath.fs" />
    <Compile Include="Shared\AppPathSettings.fs" />
    <Compile Include="Shared\TabBehaviorPolicy.fs" />
    <Compile Include="Shared\HotKeyPolicy.fs" />
    <Compile Include="Shared\LaunchPath.fs" />
    <Compile Include="Shared\Dpi.fs" />
    <Compile Include="Shared\Win32.fs" />
    <Compile Include="Shared\ProgramTypes.fs" />
    <Compile Include="Shared\DragDrop.fs" />
    <Compile Include="Shared\Serialize.fs" />
    <Compile Include="Shared\DarkMode.fs" />
    <Compile Include="Shared\Win32Menu.fs" />
    <Compile Include="Shared\Services.fs" />
    <Compile Include="Shared\SettingsTiming.fs" />
    <Compile Include="Shared\AnimationWindow.fs" />
    <Compile Include="Shared\Forms.fs" />
    <Compile Include="Shared\Json.fs" />
    <Compile Include="Shared\Shell.fs" />
    <Compile Include="Shared\Model.fs" />
    <Compile Include="Shared\UIHelper.fs" />
    <Compile Include="Shared\AppDialog.fs" />
    <Compile Include="NewWindowLaunch.fs" />
    <Compile Include="HotKeyManager.fs" />
    <Compile Include="DragDropController.fs" />
    <Compile Include="TabStripSprite.fs" />
    <Compile Include="TabStrip.fs" />
    <Compile Include="Settings.fs" />
    <Compile Include="WindowDecorator.fs" />
    <Compile Include="OleDropTarget.fs" />
    <Compile Include="WindowGroup.fs" />
    <Compile Include="TabStripDecorator.fs" />
    <Compile Include="GroupPlugins\SuperBarPlugin.fs" />
    <Compile Include="GroupPlugins\HideTabsOnInactiveGroupPlugin.fs" />
    <Compile Include="Desktop.fs" />
    <Compile Include="Launcher.fs" />
    <Compile Include="Workspace\WorkspaceModel.fs" />
    <Compile Include="Workspace\WorkspaceView.fs" />
    <Compile Include="ManagerViewService\Views\AppearanceView.fs" />
    <Compile Include="ManagerViewService\Views\BehaviorView.fs" />
    <Compile Include="ManagerViewService\Views\ShortcutKeysView.fs" />
    <Compile Include="ManagerViewService\Views\DiagnosticsView.fs" />
    <Compile Include="ManagerViewService\Views\LicenseView.fs" />
    <Compile Include="ManagerViewService\Views\ProgramView.fs" />
    <Compile Include="ManagerViewService\DesktopManagerForm.fs" />
    <Compile Include="ManagerViewService\ManagerViewService.fs" />
    <Compile Include="FilterService.fs" />
    <Compile Include="DesktopPlugins\NotifyIconPlugin.fs" />
    <Compile Include="DesktopPlugins\ExceptionHandlerPlugin.fs" />
    <Compile Include="ManagerViewService\SettingsBenchmark.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- LogicalName on every one of these is load-bearing. The code asks for
       them by bare file name (Services.openIcon "Bemo.ico"), which is what the
       legacy F# project system produced. SDK-style projects would otherwise
       prefix the manifest name with the namespace and folder
       (WindowTabs.Resources.Bemo.ico) and every icon and image would come back
       as a null stream at run time. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Bemo.ico" LogicalName="Bemo.ico" />
    <EmbeddedResource Include="Resources\workspace.png" LogicalName="workspace.png" />
    <EmbeddedResource Include="Resources\add.png" LogicalName="add.png" />
    <EmbeddedResource Include="Resources\delete.png" LogicalName="delete.png" />
    <EmbeddedResource Include="Resources\edit.ico" LogicalName="edit.ico" />
    <EmbeddedResource Include="Resources\edit.png" LogicalName="edit.png" />
    <EmbeddedResource Include="Resources\group.png" LogicalName="group.png" />
    <EmbeddedResource Include="Resources\group-closed.png" LogicalName="group-closed.png" />
    <EmbeddedResource Include="Resources\restore.png" LogicalName="restore.png" />
    <EmbeddedResource Include="Resources\window.png" LogicalName="window.png" />
  </ItemGroup>

  <!-- Shipped defaults that UserOverrides lays the user's own copy over.
       Replaces the copy step the legacy PostBuildEvent did by hand. -->
  <ItemGroup>
    <Content Include="Settings\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="app.manifest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="9.0.100" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- The committed interop assemblies, kept rather than regenerated with
       <COMReference>: that route needs the ResolveComReference task, which
       only the .NET Framework MSBuild has, so it would have made `dotnet
       build` impossible. These are pure type definitions with no framework
       dependency of their own and load fine on .NET 10 (verified by loading
       SHDocVw.ShellWindowsClass and Shell32.IShellFolderViewDual and
       instantiating the former). Only Shell.fs uses them, to find the folder
       an Explorer window is showing. -->
  <ItemGroup>
    <Reference Include="Interop.SHDocVw">
      <HintPath>..\Interop.SHDocVw.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Interop.Shell32">
      <HintPath>..\Interop.Shell32.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Win32\Win32.csproj" />
    <ProjectReference Include="..\treeviewadv\Aga.Controls\Aga.Controls.csproj" />
  </ItemGroup>

</Project>
